{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "full-gpu",
      "displayName": "All native CPU and GPU backends",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "GRAPHMINE_ENABLE_CUDAMS": "ON",
        "GRAPHMINE_ENABLE_CUDA_BACKENDS": "ON",
        "GRAPHMINE_ENABLE_CUMBE": "ON",
        "GRAPHMINE_ENABLE_CUQC": "ON",
        "GRAPHMINE_ENABLE_DUMATO_MOTIF": "ON",
        "GRAPHMINE_ENABLE_EDTC": "ON",
        "GRAPHMINE_ENABLE_EVEREST": "ON",
        "GRAPHMINE_ENABLE_G2_AIMD": "ON",
        "GRAPHMINE_ENABLE_GAMMA_KCLIQUE": "ON",
        "GRAPHMINE_ENABLE_GLEIDEN": "ON",
        "GRAPHMINE_ENABLE_GMATCH": "ON",
        "GRAPHMINE_ENABLE_GPU_MAXIMUM_CLIQUE": "ON",
        "GRAPHMINE_ENABLE_GRAPHMINER_MOTIF": "ON",
        "GRAPHMINE_ENABLE_GRAPHSET_KCLIQUE": "ON",
        "GRAPHMINE_ENABLE_GRAPHSET_MOTIF": "ON",
        "GRAPHMINE_ENABLE_KCGPU": "ON",
        "GRAPHMINE_ENABLE_KCOREGPU": "ON",
        "GRAPHMINE_ENABLE_MAXIMUM_CLIQUE_ON_GPU": "ON",
        "GRAPHMINE_ENABLE_MAYURA": "ON",
        "GRAPHMINE_ENABLE_MCE_GPU": "ON",
        "GRAPHMINE_ENABLE_PGGC": "ON",
        "GRAPHMINE_ENABLE_RDMCE": "ON",
        "GRAPHMINE_ENABLE_REPAIRED_WORKERS": "ON",
        "GRAPHMINE_ENABLE_TOT": "ON",
        "GRAPHMINE_ENABLE_TURBOBC": "ON",
        "GRAPHMINE_ENABLE_VALIDATED_EXPANSION": "ON",
        "GRAPHMINE_ENABLE_WETRIC": "ON",
        "GRAPHMINE_BUILD_NATIVE_RUNTIME": "ON",
        "GRAPHMINE_BUILD_CLI": "ON",
        "GRAPHMINE_BUILD_TESTS": "ON",
        "GRAPHMINE_BUILD_EXAMPLES": "OFF",
        "GRAPHMINE_NATIVE_CUGRAPH": "ON",
        "GRAPHMINE_NATIVE_CUGRAPH_CPP": "ON",
        "GRAPHMINE_NATIVE_CUDF": "ON",
        "GRAPHMINE_NATIVE_OPTIMIZATION": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "full-gpu",
      "configurePreset": "full-gpu"
    }
  ]
}
