+#pragma once
+
+// GraphMine runs exactly one job per disposable native process. These controls
+// are supplied only by its supervisor, never by user Cypher. A process budget
+// cannot be reset by llm_usage(), a second expression, planning, or a retry.
+#include <atomic>
+#include <charconv>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include "common/exception/runtime.h"
+#ifndef _WIN32
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#endif
+
+namespace lbug::function::llm {
+std::string jsonQuote(const std::string&);
+
+inline bool graphmineStrict() {
+    const auto* value = std::getenv("GRAPHMINE_TENTO_STRICT");
+    return value != nullptr && std::string(value) == "1";
+}
+
+inline std::string graphmineCacheIdentity() {
+    std::string identity = graphmineStrict() ? "\ngraphmine:strict-json,thinking-off:v1" : "";
+    if (const auto* value = std::getenv("GRAPHMINE_TENTO_CACHE_NAMESPACE")) {
+        identity += "\n" + std::string(value);
+    }
+    return identity;
+}
+
+inline void graphmineReserveRequest() {
+    const auto* value = std::getenv("GRAPHMINE_TENTO_REQUEST_LIMIT");
+    if (value == nullptr) {
+        if (graphmineStrict()) {
+            throw common::RuntimeException("graphmine_request_limit_missing");
+        }
+        return;
+    }
+    uint64_t limit = 0;
+    const auto* end = value + std::strlen(value);
+    const auto parsed = std::from_chars(value, end, limit);
+    if (parsed.ec != std::errc() || parsed.ptr != end || limit == 0) {
+        throw common::RuntimeException("graphmine_request_limit_invalid");
+    }
+    static std::atomic<uint64_t> used{0};
+    auto previous = used.load();
+    do {
+        if (previous >= limit) {
+            throw common::RuntimeException("graphmine_request_limit");
+        }
+    } while (!used.compare_exchange_weak(previous, previous + 1));
+}
+
+// A private admission socket is optional for standalone probes/paper runs.
+// In the app, every HTTP attempt waits for the parent's shared planner slot,
+// token reservation and power lease. The native engine still performs HTTP.
+// Closing the socket (including hard cancellation) releases the parent lease.
+class GraphmineAdmission {
+public:
+    GraphmineAdmission() = default;
+    GraphmineAdmission(const GraphmineAdmission&) = delete;
+    GraphmineAdmission& operator=(const GraphmineAdmission&) = delete;
+    ~GraphmineAdmission() {
+#ifndef _WIN32
+        if (fd >= 0) { ::close(fd); }
+#endif
+    }
+    void begin(const std::string& baseURL, const std::string& body) {
+#ifndef _WIN32
+        const auto* path = std::getenv("GRAPHMINE_TENTO_ADMISSION");
+        if (path == nullptr) { return; }
+        sockaddr_un address{};
+        address.sun_family = AF_UNIX;
+        if (std::strlen(path) >= sizeof(address.sun_path)) {
+            throw common::RuntimeException("graphmine_admission_path");
+        }
+        std::strcpy(address.sun_path, path);
+        fd = ::socket(AF_UNIX, SOCK_STREAM, 0);
+        if (fd < 0 || ::connect(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0) {
+            throw common::RuntimeException("graphmine_admission_unavailable");
+        }
+        sendLine("{\"base_url\":" + jsonQuote(baseURL) + ",\"body\":" + body + "}");
+        std::string reply;
+        char next;
+        while (reply.size() < 1024 && ::recv(fd, &next, 1, 0) == 1 && next != '\n') {
+            reply += next;
+        }
+        if (reply != "ok") {
+            throw common::RuntimeException("graphmine_admission_denied");
+        }
+#else
+        throw common::RuntimeException("graphmine_admission_requires_linux");
+#endif
+    }
+    void finish(int status, const std::string& response) {
+#ifndef _WIN32
+        if (fd < 0) { return; }
+        sendLine("{\"status\":" + std::to_string(status) + ",\"response\":" + jsonQuote(response) + "}");
+        // Wait until the parent has settled this attempt before issuing another.
+        char next;
+        while (::recv(fd, &next, 1, 0) == 1 && next != '\n') {}
+        ::close(fd);
+        fd = -1;
+#endif
+    }
+private:
+    void sendLine(const std::string& text) {
+#ifndef _WIN32
+        const auto line = text + "\n";
+        size_t sent = 0;
+        while (sent < line.size()) {
+            const auto count = ::send(fd, line.data() + sent, line.size() - sent, MSG_NOSIGNAL);
+            if (count <= 0) { throw common::RuntimeException("graphmine_admission_unavailable"); }
+            sent += count;
+        }
+#endif
+    }
+    int fd = -1;
+};
+} // namespace lbug::function::llm
