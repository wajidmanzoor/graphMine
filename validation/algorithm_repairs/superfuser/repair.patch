+__host__ __device__ inline uint64_t mix64(uint64_t h) {
+    h^=h>>30;h*=0xbf58476d1ce4e5b9ULL;h^=h>>27;h*=0x94d049bb133111ebULL;return h^(h>>31);
+}
+constexpr uint64_t EDGE_KEY=0x6a09e667f3bcc909ULL;
+constexpr uint64_t RANK_KEY=0xbb67ae8584caa73bULL;
+constexpr uint64_t EVAL_KEY=0x3c6ef372fe94f82bULL;
+__host__ __device__ inline uint64_t draw(uint64_t key,uint64_t item,uint64_t sample) {
+    return mix64(key^mix64(item+0x9e3779b97f4a7c15ULL)^mix64(sample+0xd1b54a32d192ed03ULL));
+}
+__host__ __device__ inline bool live(uint64_t edge,uint64_t threshold,uint64_t sample,uint64_t seed) {
+    // Explicit endpoints: p=0 is never live, p=1 is always live. Each edge and
+    // sample has its own counter; XORing one random word across edges is biased.
+    return (draw(seed^EDGE_KEY,edge,sample)>>32)<threshold;
+}
+struct DeviceGraph {uint32_t n;const uint64_t* offsets;const Edge* edges;};
+
+__global__ void fill_hypersx(float* values,const uint32_t* active,size_t states,
+    uint32_t samples,uint32_t sample_start,uint64_t seed,bool char_sketch) {
+    for(size_t i=blockIdx.x*static_cast<size_t>(blockDim.x)+threadIdx.x;i<states;i+=gridDim.x*static_cast<size_t>(blockDim.x)) {
+        if(active[i]){values[i]=-1;continue;}
+        uint64_t nonce=draw(seed^RANK_KEY,i/samples,sample_start+i%samples);
+        if(char_sketch)values[i]=__clzll(nonce)+1;
+        else {
+            float reciprocal=0;
+            for(int k=0;k<4;++k){nonce=mix64(nonce+k+1);reciprocal+=1.0f/(__clzll(nonce)+1);}
+            values[i]=4.0f/reciprocal;
+        }
+    }
+}
+__global__ void simulate_kernelng(DeviceGraph graph,const float* previous,float* next,
+    uint32_t samples,uint32_t sample_start,uint64_t seed,int* changed) {
+    size_t states=static_cast<size_t>(graph.n)*samples;
+    for(size_t i=blockIdx.x*static_cast<size_t>(blockDim.x)+threadIdx.x;i<states;i+=gridDim.x*static_cast<size_t>(blockDim.x)) {
+        uint32_t vertex=i/samples,sample=i%samples;
+        float value=previous[i];
+        if(value>=0)for(uint64_t e=graph.offsets[vertex];e<graph.offsets[vertex+1];++e)
+            if(live(e,graph.edges[e].threshold,sample_start+sample,seed))value=fmaxf(value,previous[static_cast<size_t>(graph.edges[e].vertex)*samples+sample]);
+        next[i]=value;
+        if(value!=previous[i])atomicExch(changed,1);
+    }
+}
+__device__ inline double sum_block(double value) {
+    __shared__ double sums[32];
+    unsigned lane=threadIdx.x&31,warp=threadIdx.x>>5;
+    for(int offset=16;offset;offset>>=1)value+=__shfl_down_sync(0xffffffff,value,offset);
+    if(!lane)sums[warp]=value;
+    __syncthreads();
+    value=threadIdx.x<blockDim.x/32?sums[lane]:0;
+    if(!warp)for(int offset=16;offset;offset>>=1)value+=__shfl_down_sync(0xffffffff,value,offset);
+    __syncthreads(); // Protect shared storage before another row reuses it.
+    return value;
+}
+__global__ void maxsum_gpu(const float* values,uint32_t n,uint32_t samples,double* scores) {
+    for(uint64_t v=blockIdx.x;v<n;v+=gridDim.x){
+        double sum=0;
+        for(uint32_t r=threadIdx.x;r<samples;r+=blockDim.x)sum+=fmaxf(0,values[v*samples+r]);
+        sum=sum_block(sum);
+        if(!threadIdx.x)scores[v]=sum;
+    }
+}
+__global__ void start_cascade(uint32_t vertex,uint32_t samples,uint32_t* active,unsigned char* frontier) {
+    for(uint32_t r=blockIdx.x*blockDim.x+threadIdx.x;r<samples;r+=blockDim.x*gridDim.x){
+        size_t i=static_cast<size_t>(vertex)*samples+r;
+        if(atomicCAS(active+i,0u,1u)==0)frontier[i]=1;
+    }
+}
+__global__ void process_queueng(DeviceGraph graph,const unsigned char* frontier,unsigned char* next,
+    uint32_t* active,uint32_t samples,uint32_t sample_start,uint64_t seed,int* changed) {
+    size_t states=static_cast<size_t>(graph.n)*samples;
+    for(size_t i=blockIdx.x*static_cast<size_t>(blockDim.x)+threadIdx.x;i<states;i+=gridDim.x*static_cast<size_t>(blockDim.x)) {
+        if(!frontier[i])continue;
+        uint32_t vertex=i/samples,sample=i%samples;
+        for(uint64_t e=graph.offsets[vertex];e<graph.offsets[vertex+1];++e){
+            if(!live(e,graph.edges[e].threshold,sample_start+sample,seed))continue;
+            size_t dest=static_cast<size_t>(graph.edges[e].vertex)*samples+sample;
+            if(atomicCAS(active+dest,0u,1u)==0){next[dest]=1;atomicExch(changed,1);}
+        }
+    }
+}
+__global__ void count_active(const uint32_t* active,size_t states,unsigned long long* count) {
+    unsigned long long local=0;
+    for(size_t i=blockIdx.x*static_cast<size_t>(blockDim.x)+threadIdx.x;i<states;i+=gridDim.x*static_cast<size_t>(blockDim.x))local+=active[i];
+    if(local)atomicAdd(count,local);
+}
