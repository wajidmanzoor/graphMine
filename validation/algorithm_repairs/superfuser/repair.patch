+struct Result {
+    std::vector<uint32_t> seeds;
+    std::vector<double> spread,training_spread,seconds;
+};
+inline Result solve(const HostGraph& graph,const Options& options,const std::vector<int>& devices) {
+    if(options.seeds>graph.n)throw std::runtime_error("seed count exceeds vertex count");
+    Result result;
+    if(!options.seeds)return result;
+    if(devices.empty() || devices.size()>options.samples)throw std::runtime_error("invalid sample partition");
+    auto start_time=std::chrono::steady_clock::now();
+    std::vector<std::unique_ptr<Shard>> shards;
+    for(size_t i=0;i<devices.size();++i){
+        uint32_t begin=static_cast<uint64_t>(options.samples)*i/devices.size();
+        uint32_t end=static_cast<uint64_t>(options.samples)*(i+1)/devices.size();
+        shards.push_back(std::make_unique<Shard>(graph,devices[i],begin,end-begin,options));
+    }
+    std::vector<unsigned char> selected(graph.n);
+    for(uint32_t k=0;k<options.seeds;++k){
+        std::vector<double> scores(graph.n);
+        for(auto& shard:shards){
+            shard->rebuild(options.char_sketch);auto local=shard->scores();
+            for(size_t v=0;v<graph.n;++v)scores[v]+=local[v];
+        }
+        uint32_t best=0;double best_score=-1;
+        for(uint64_t v=0;v<graph.n;++v)if(!selected[v] && scores[v]>best_score){best=v;best_score=scores[v];}
+        if(best_score<0)throw std::runtime_error("no unselected candidate");
+        selected[best]=1;result.seeds.push_back(best);
+        unsigned long long count=0;
+        for(auto& shard:shards)count+=shard->cascade(best);
+        result.training_spread.push_back(static_cast<double>(count)/options.samples);
+        result.seconds.push_back(std::chrono::duration<double>(std::chrono::steady_clock::now()-start_time).count());
+    }
+    // Estimate the selected prefixes on an independent live-edge ensemble,
+    // avoiding selection bias from reusing the training samples for reporting.
+    for(auto& shard:shards)shard->holdout();
+    for(uint32_t seed:result.seeds){
+        unsigned long long count=0;
+        for(auto& shard:shards)count+=shard->cascade(seed);
+        result.spread.push_back(static_cast<double>(count)/options.samples);
+    }
+    return result;
+}
+} // namespace superfuser
