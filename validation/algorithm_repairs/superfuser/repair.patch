+int superfuser_main(int argc,char** argv) {
+    using namespace superfuser;
+    if(argc==2 && std::string(argv[1])=="--help"){
+        std::cout<<"Usage: superfuser [-g DEVICES] [-K SEEDS] [-R SAMPLES] [-B THREADS] "
+                   "[-M float|char] [--seed UINT64] [--model independent_cascade] "
+                   "[--json] [-o OUTPUT] GRAPH\n";
+        return 0;
+    }
+    Options options=parse_options(argc,argv);
+    int count=0;SF_CUDA(cudaGetDeviceCount(&count));
+    if(options.devices>count)throw std::runtime_error("requested CUDA devices are not visible");
+    uint64_t max_vertices=UINT32_MAX;
+    for(int device=0;device<options.devices;++device){
+        SF_CUDA(cudaSetDevice(device));size_t available,total;SF_CUDA(cudaMemGetInfo(&available,&total));
+        uint64_t local=(static_cast<uint64_t>(options.samples)+options.devices-1)/options.devices;
+        max_vertices=std::min(max_vertices,(available-available/10)/(14*local+16));
+    }
+    HostGraph graph=read_graph(options.input,max_vertices);
+    if(options.seeds>graph.n)throw std::runtime_error("seed count exceeds vertex count");
+    if(!options.output.empty() && std::filesystem::exists(options.output) && std::filesystem::equivalent(options.input,options.output))
+        throw std::runtime_error("output must not overwrite the input graph");
+    std::ofstream file;
+    if(!options.output.empty()){
+        file.open(options.output);if(!file)throw std::runtime_error("cannot create output file");
+    }
+    std::vector<int> devices(options.devices);std::iota(devices.begin(),devices.end(),0);
+    Result result=solve(graph,options,devices);
+    std::ostream& out=options.output.empty()?std::cout:file;out<<std::setprecision(17);
+    if(options.json){
+        out<<"{\"diffusion_model\":\"independent_cascade\",\"guarantee_met\":false,\"sample_count\":"<<options.samples
+           <<",\"evaluation_sample_count\":"<<options.samples<<",\"random_seed\":"<<options.random_seed<<",\"seed_set\":[";
+        for(size_t i=0;i<result.seeds.size();++i){if(i)out<<',';out<<result.seeds[i];}
+        out<<"],\"expected_spread\":"<<(result.spread.empty()?0:result.spread.back())<<",\"prefix_spread\":[";
+        for(size_t i=0;i<result.spread.size();++i){if(i)out<<',';out<<result.spread[i];}
+        out<<"],\"training_prefix_spread\":[";
+        for(size_t i=0;i<result.training_spread.size();++i){if(i)out<<',';out<<result.training_spread[i];}
+        out<<"]}\n";
+    }else for(size_t i=0;i<result.seeds.size();++i)out<<result.seeds[i]<<'\t'<<result.spread[i]<<'\t'<<result.seconds[i]<<'\n';
+    if(file.is_open()){file.close();if(!file)throw std::runtime_error("cannot finish writing output");}
+    return 0;
+}
