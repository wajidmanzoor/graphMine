-    T reg = mask[j];
-    for (size_t i = blockIdx.x; i < N; i += (gridDim.x)) {
-        T2 m = max(hypers[i * R + j], reg);
-        int b = m >= 0;
-        if (b) m = 1.0f / float(m);
-        else m = 0;
-        b = reduce_block(b);
-        m = reduce_block(m);
-        if (j == 0)
-            if (m == 0) estimates[i] = 0;
-            else estimates[i] = (float(b)) / m;
-    }
-}
