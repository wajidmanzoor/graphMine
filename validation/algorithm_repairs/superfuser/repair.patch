new file mode 100644
index 0000000..03b18f7
--- /dev/null
+++ b/src/gpu_input.h
@@ -0,0 +1,128 @@
+#pragma once
+#include <algorithm>
+#include <charconv>
+#include <cmath>
+#include <cstdint>
+#include <fstream>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <tuple>
+#include <vector>
+
+namespace superfuser {
+struct Edge { uint32_t vertex; uint64_t threshold; };
+struct HostGraph {
+    uint32_t n = 0;
+    std::vector<uint64_t> offsets;
+    std::vector<Edge> edges;
+};
+struct Options {
+    uint32_t seeds = 50, samples = 256;
+    uint64_t random_seed = 42;
+    int devices = 1, block_size = 256;
+    bool char_sketch = false, json = false;
+    std::string input, output;
+};
+inline uint64_t integer(const std::string& text) {
+    uint64_t value = 0;
+    auto r = std::from_chars(text.data(),text.data()+text.size(),value);
+    if (text.empty() || r.ec != std::errc() || r.ptr != text.data()+text.size())
+        throw std::runtime_error("expected a nonnegative integer: " + text);
+    return value;
+}
+inline bool data_line(std::istream& in,std::string& line) {
+    while (std::getline(in,line)) {
+        auto comment=line.find('#');
+        if (comment != std::string::npos) line.resize(comment);
+        if (line.find_first_not_of(" \t\r\n") != std::string::npos) return true;
+    }
+    return false;
+}
+inline HostGraph read_graph(const std::string& filename,uint64_t max_vertices=UINT32_MAX) {
+    std::ifstream in(filename);
+    if (!in) throw std::runtime_error("cannot open graph: " + filename);
+    std::string line,a,b,p,extra;
+    if (!data_line(in,line)) throw std::runtime_error("missing graph header");
+    std::istringstream header(line);
+    if (!(header>>a>>b) || header>>extra) throw std::runtime_error("header must contain n m");
+    uint64_t n=integer(a),m=integer(b);
+    if (n>UINT32_MAX || n>max_vertices) throw std::runtime_error("vertex count exceeds the available GPU state capacity");
+    struct InputEdge { uint32_t source,target; long double probability; };
+    std::vector<InputEdge> input;
+    for (uint64_t e=0;e<m;++e) {
+        if (!data_line(in,line)) throw std::runtime_error("fewer edge rows than declared");
+        std::istringstream row(line);
+        if (!(row>>a>>b>>p) || row>>extra) throw std::runtime_error("edge row must contain source target probability");
+        uint64_t u=integer(a),v=integer(b);
+        size_t used=0;
+        long double probability;
+        try { probability=std::stold(p,&used); } catch (...) { throw std::runtime_error("invalid edge probability"); }
+        if (used!=p.size() || !std::isfinite(probability) || probability<0 || probability>1)
+            throw std::runtime_error("edge probability must be finite and in [0,1]");
+        if (u>=n || v>=n) throw std::runtime_error("edge vertex out of range");
+        if (u!=v && probability>0) input.push_back({static_cast<uint32_t>(u),static_cast<uint32_t>(v),probability});
+    }
+    if (data_line(in,line)) throw std::runtime_error("more edge rows than declared");
+    if (!in.eof()) throw std::runtime_error("graph read failed");
+    std::sort(input.begin(),input.end(),[](const auto& a,const auto& b) {
+        return std::tie(a.source,a.target,a.probability)<std::tie(b.source,b.target,b.probability);
+    });
+    HostGraph graph;graph.n=n;graph.offsets.assign(n+1,0);
+    for (size_t e=0;e<input.size();) {
+        size_t end=e;
+        long double survival=1;
+        while (end<input.size() && input[end].source==input[e].source && input[end].target==input[e].target)
+            survival*=1-input[end++].probability;
+        // Independent parallel attempts combine as 1-product(1-p). Self loops
+        // cannot activate a new vertex and were discarded above.
+        uint64_t threshold=static_cast<uint64_t>((1-survival)*4294967296.0L);
+        if (threshold) {
+            graph.edges.push_back({input[e].target,threshold});
+            ++graph.offsets[input[e].source+1];
+        }
+        e=end;
+    }
+    for (size_t v=1;v<graph.offsets.size();++v) graph.offsets[v]+=graph.offsets[v-1];
+    return graph;
+}
+inline Options parse_options(int argc,char** argv) {
+    Options options;
+    for (int i=1;i<argc;++i) {
+        std::string flag=argv[i];
+        auto argument=[&]() -> std::string {
+            if (++i>=argc) throw std::runtime_error("missing value for " + flag);
+            return argv[i];
+        };
+        if (flag=="-K") {
+            auto value=integer(argument());if(value>UINT32_MAX)throw std::runtime_error("seed count out of range");options.seeds=value;
+        } else if (flag=="-R") {
+            auto value=integer(argument());
+            if(value<32 || value>(1u<<24) || value%32)throw std::runtime_error("sample count must be a multiple of 32 in [32,2^24]");
+            options.samples=value;
+        } else if(flag=="-g") {
+            auto value=integer(argument());if(value<1 || value>64)throw std::runtime_error("device count must be in [1,64]");options.devices=value;
+        } else if(flag=="-B") {
+            auto value=integer(argument());if(value<32 || value>1024 || (value&(value-1)))throw std::runtime_error("block size must be a power of two in [32,1024]");options.block_size=value;
+        } else if(flag=="--seed") options.random_seed=integer(argument());
+        else if(flag=="-o") options.output=argument();
+        else if(flag=="--json") options.json=true;
+        else if(flag=="--model") {
+            if(argument()!="independent_cascade")throw std::runtime_error("SuperFuser supports independent_cascade only");
+        } else if(flag=="-M") {
+            auto method=argument();
+            if(method!="float" && method!="char" && method!="super" && method!="SingleGPU" && method!="MultiGPU")
+                throw std::runtime_error("unknown SuperFuser sketch method");
+            options.char_sketch=method=="char";
+        } else if(!flag.empty() && flag[0]=='-') throw std::runtime_error("unsupported option: " + flag);
+        else {
+            if(!options.input.empty())throw std::runtime_error("expected exactly one input graph");
+            options.input=flag;
+        }
+    }
+    if(options.input.empty())throw std::runtime_error("missing input graph");
+    if(!options.output.empty() && options.output==options.input)throw std::runtime_error("output must differ from input graph");
+    return options;
+}
+} // namespace superfuser
