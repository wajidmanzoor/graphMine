diff --git a/code/TrimCDP-WB/include/witness.hpp b/code/TrimCDP-WB/include/witness.hpp
new file mode 100644
index 0000000..a882142
--- /dev/null
+++ b/code/TrimCDP-WB/include/witness.hpp
@@ -0,0 +1,118 @@
+#ifndef GPU4GST_WITNESS_HPP
+#define GPU4GST_WITNESS_HPP
+#include <functional>
+#include <numeric>
+#include <set>
+#include <tuple>
+
+// Decode equalities in the GPU-computed tables. This does not solve a second
+// Steiner problem: every accepted edge/merge must reproduce a GPU cost label.
+struct GSTWitness {
+    std::set<int> vertices;
+    std::set<std::tuple<int,int,feature_t>> edges;
+    void add(const GSTWitness& other) {
+        vertices.insert(other.vertices.begin(),other.vertices.end());
+        edges.insert(other.edges.begin(),other.edges.end());
+    }
+    void edge(int u,int v,feature_t weight) {
+        vertices.insert(u); vertices.insert(v);
+        if (u != v) edges.emplace(std::min(u,v),std::max(u,v),weight);
+    }
+};
+
+template<class Graph>
+GSTWitness decode_witness(const Graph& g, const std::vector<int>& query, int width,
+    const std::vector<feature_t>& dp, const std::vector<feature_t>& singleton, feature_t optimum) {
+    int n = g.vert_count, full = width-1;
+    std::vector<int> coverage(n);
+    for (size_t i = 0; i < query.size(); ++i)
+        for (auto member : g.group_graph[query[i]]) coverage[member.first] |= 1<<i;
+    auto value = [&](int v,int mask) {
+        return (mask && !(mask&(mask-1)) ? singleton : dp)[static_cast<size_t>(v)*width+mask];
+    };
+    std::function<bool(int,int,GSTWitness&)> decode = [&](int root,int mask,GSTWitness& answer) {
+        if (value(root,mask) == inf) return false;
+        std::vector<int> previous(n,-1), queue{root};
+        std::vector<feature_t> previous_weight(n);
+        previous[root] = root;
+        for (size_t next = 0; next < queue.size(); ++next) {
+            int v = queue[next];
+            feature_t cost = value(v,mask);
+            GSTWitness local;
+            bool found = cost == 0 && (coverage[v]&mask) == mask;
+            if (found) local.vertices.insert(v);
+            for (int left = (mask-1)&mask; left && !found; left = (left-1)&mask) {
+                int right = mask^left;
+                if (left > right || value(v,left)+value(v,right) != cost) continue;
+                GSTWitness a,b;
+                if (decode(v,left,a) && decode(v,right,b)) {
+                    local.add(a); local.add(b); found = true;
+                }
+            }
+            // TrimCDP may finish a full tree using a partial tree plus one
+            // shortest path per remaining group, before explicit merge states.
+            if (mask == full && !found) {
+                for (int left = (mask-1)&mask; left && !found; left = (left-1)&mask) {
+                    feature_t candidate = value(v,left);
+                    for (int bit = 1; bit < width; bit <<= 1)
+                        if ((mask^left)&bit) candidate += singleton[static_cast<size_t>(v)*width+bit];
+                    if (candidate != cost) continue;
+                    GSTWitness combined;
+                    bool okay = decode(v,left,combined);
+                    for (int bit = 1; bit < width && okay; bit <<= 1)
+                        if ((mask^left)&bit) {
+                            GSTWitness branch;
+                            okay = decode(v,bit,branch);
+                            combined.add(branch);
+                        }
+                    if (okay) { local.add(combined); found = true; }
+                }
+            }
+            if (found) {
+                for (int u = v; u != root; u = previous[u]) local.edge(previous[u],u,previous_weight[u]);
+                answer.add(local);
+                return true;
+            }
+            for (index_t e = g.beg_pos[v]; e < g.end_pos[v]; ++e) {
+                int u = g.adj_list[e];
+                if (previous[u] == -1 && g.weight[e]+value(u,mask) == cost) {
+                    previous[u] = v; previous_weight[u] = g.weight[e]; queue.push_back(u);
+                }
+            }
+        }
+        return false;
+    };
+    GSTWitness result;
+    bool found = false;
+    for (int v = 0; v < n && !found; ++v)
+        if (dp[static_cast<size_t>(v)*width+full] == optimum) found = decode(v,full,result);
+    if (!found) throw std::runtime_error("cannot reconstruct the GPU optimum from its state tables");
+    // Remove zero-cost cycles in the decoded union. Positive-cost redundancy
+    // would contradict the claimed optimum, and is rejected below.
+    std::vector<std::tuple<feature_t,int,int>> sorted;
+    for (auto [u,v,w] : result.edges) sorted.emplace_back(w,u,v);
+    std::sort(sorted.begin(),sorted.end());
+    std::vector<int> parent(n);
+    std::iota(parent.begin(),parent.end(),0);
+    auto root = [&](int v) { while (v != parent[v]) { parent[v] = parent[parent[v]]; v = parent[v]; } return v; };
+    result.edges.clear();
+    feature_t sum = 0;
+    for (auto [w,u,v] : sorted) {
+        int a = root(u), b = root(v);
+        if (a != b) { parent[a] = b; result.edge(u,v,w); sum += w; }
+    }
+    int covered = 0;
+    for (int v : result.vertices) covered |= coverage[v];
+    if (result.vertices.empty() || result.edges.size()+1 != result.vertices.size() || covered != full || sum != optimum)
+        throw std::runtime_error("decoded tree does not certify the GPU optimum: expected cost " + std::to_string(optimum) + ", tree cost " + std::to_string(sum) + ", coverage " + std::to_string(covered) + "/" + std::to_string(full));
+    return result;
+}
+inline void print_witness(int query, feature_t cost, const GSTWitness& tree) {
+    std::cout << "witness {\"query\":" << query << ",\"cost\":" << cost << ",\"vertices\":[";
+    bool comma = false;
+    for (int v : tree.vertices) { if (comma) std::cout << ','; std::cout << v; comma = true; }
+    std::cout << "],\"edges\":["; comma = false;
+    for (auto [u,v,w] : tree.edges) { if (comma) std::cout << ','; std::cout << '[' << u << ',' << v << ',' << w << ']'; comma = true; }
+    std::cout << "]}\n";
+}
+#endif
