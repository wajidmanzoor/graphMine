+void graph<FV,FI,FW,V,I,W>::split_high_degree_vertices() {
+    original_vert_count = vert_count;
+    new_vert_count = vert_count;
+    for (I v = 0; v < vert_count; ++v) {
+        I degree = beg_pos[v+1]-beg_pos[v];
+        if (degree > 1024) {
+            uint64_t count = static_cast<uint64_t>(new_vert_count)+(degree+511)/512;
+            if (count > INT_MAX) throw std::runtime_error("virtual vertices exceed index capacity");
+            new_vert_count = count;
+        }
+    }
+    mother_map.resize(new_vert_count);
+    son_d_map.resize(new_vert_count);
+    son_range_start_map.resize(new_vert_count);
+    son_range_end_map.resize(new_vert_count);
+    I next = vert_count;
+    for (I v = 0; v < vert_count; ++v) {
+        mother_map[v] = son_d_map[v] = v;
+        son_range_start_map[v] = son_range_end_map[v] = next;
+        I degree = beg_pos[v+1]-beg_pos[v];
+        if (degree <= 1024) continue;
+        son_d_map[v] = next;
+        for (I part = 0; part < (degree+511)/512; ++part, ++next) {
+            mother_map[next] = v;
+            son_d_map[next] = next;
+            son_range_start_map[next] = son_range_end_map[next] = next;
+            son_list_map.push_back(next);
+        }
+        son_range_end_map[v] = next;
+    }
