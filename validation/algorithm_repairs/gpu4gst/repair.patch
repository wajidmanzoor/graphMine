+// Input files are headerless arrays of signed 64-bit little-endian integers.
+template<class T> std::vector<T> read_graph_array(const char* name) {
+    std::ifstream in(name, std::ios::binary | std::ios::ate);
+    if (!in) throw std::runtime_error(std::string("cannot open ") + name);
+    auto size = in.tellg();
+    if (size < 0 || size % sizeof(T)) throw std::runtime_error("truncated graph array");
+    size_t count = static_cast<size_t>(size) / sizeof(T);
+    if (count > static_cast<size_t>(INT_MAX)) throw std::runtime_error("graph exceeds 32-bit index capacity");
+    std::vector<T> values(count);
+    in.seekg(0);
+    if (size && !in.read(reinterpret_cast<char*>(values.data()), size))
+        throw std::runtime_error("cannot read complete graph array");
+    return values;
+}
 
