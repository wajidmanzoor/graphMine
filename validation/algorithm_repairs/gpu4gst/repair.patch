+    if (first > last) throw std::runtime_error("FIRST must not exceed LAST");
+    std::filesystem::path path(argv[2]);
+    std::string dataset(argv[3]);
+    if (dataset.empty() || dataset == "." || dataset == ".." || dataset.find('/') != std::string::npos)
+        throw std::runtime_error("DATASET must be a filename stem");
+    using HostGraph = graph<long,long,long,vertex_t,index_t,weight_t>;
+    auto g = std::make_unique<HostGraph>((path/(dataset+"_beg_pos.bin")).c_str(),
+        (path/(dataset+"_csr.bin")).c_str(), (path/(dataset+"_weight.bin")).c_str());
+    g->read_gi((path/(dataset+".g")).string(), (path/(dataset+std::to_string(G)+".csv")).string());
+    if (static_cast<size_t>(last) >= g->inquire.size()) throw std::runtime_error("query range out of bounds");
+    for (auto& group : g->group_graph)
+        for (auto member : group)
+            if (static_cast<unsigned>(member.first) >= g->vert_count) throw std::runtime_error("group vertex out of range");
+    for (auto& query : g->inquire) {
+        if (query.size() != static_cast<size_t>(G)) throw std::runtime_error("query arity does not match GROUP_COUNT");
+        for (int id : query)
+            if (static_cast<size_t>(id) >= g->group_graph.size()) throw std::runtime_error("query group out of range");
+    }
+    int width = 1 << G, V = g->vert_count;
+    if (static_cast<uint64_t>(g->new_vert_count)*width > INT_MAX)
+        throw std::runtime_error("vertex-mask and virtual-row states exceed 32-bit queue capacity");
+    size_t states = static_cast<size_t>(V)*width;
+    std::filesystem::create_directories(path/"result");
+    std::ofstream output(path/"result"/("exp_GPU2_nonHop_"+dataset+"_T"+std::to_string(G)+"_"+std::to_string(first)+"-"+std::to_string(last)+".csv"));
+    if (!output) throw std::runtime_error("cannot create result CSV");
+    output << "task_ID,task,GPU2_nonHop_time,GPU2_nonHop_cost,GPU2_nonHop_memory,counts,process_num\n";
+    if (V == 0) {
+        for (int q = first; q <= last; ++q) {
+            std::cout << "query " << q << "\nmin cost infeasible\n";
+            output << q << ",,0,infeasible,0,0,0\n";
+        }
+        return 0;
+    }
+    H_ERR(cudaSetDevice(0)); // CUDA_VISIBLE_DEVICES controls the physical device.
+    size_t free_bytes, total_bytes;
+    H_ERR(cudaMemGetInfo(&free_bytes, &total_bytes));
+    uint64_t merge_count = 1;
+    for (int i = 0; i < G; ++i) merge_count *= 3;
+    uint64_t required = states*80 + static_cast<uint64_t>(g->new_vert_count)*width*4
+        + static_cast<uint64_t>(g->edge_count)*12 + merge_count*4
+        + static_cast<uint64_t>(G*G+G)*width*8 + 100*1024*1024;
+    if (required > free_bytes-free_bytes/10) throw std::runtime_error("insufficient GPU memory for exact vertex-mask state tables");
+    auto subsets = graph_v_of_v_idealID_DPBF_non_overlapped_group_sets_gpu(width-1);
+    int *merge_groups, *merge_offsets, *can_find, *set_num;
+    feature_t *w_d, *w1_d, *level;
+    H_ERR(cudaMalloc((void**)&merge_groups, subsets.length*sizeof(int)));
+    H_ERR(cudaMalloc((void**)&merge_offsets, (width+1)*sizeof(int)));
+    H_ERR(cudaMemcpy(merge_groups, subsets.non_overlapped_group_sets_IDs.data(), subsets.length*sizeof(int), cudaMemcpyHostToDevice));
+    H_ERR(cudaMemcpy(merge_offsets, subsets.non_overlapped_group_sets_IDs_pointer_host.data(), (width+1)*sizeof(int), cudaMemcpyHostToDevice));
+    H_ERR(cudaMalloc((void**)&w_d, static_cast<size_t>(G)*G*width*sizeof(feature_t)));
+    H_ERR(cudaMalloc((void**)&w1_d, static_cast<size_t>(G)*width*sizeof(feature_t)));
+    H_ERR(cudaMalloc((void**)&level, 10*sizeof(feature_t)));
+    H_ERR(cudaMallocManaged((void**)&can_find, sizeof(int)));
+    H_ERR(cudaMallocManaged((void**)&set_num, sizeof(int)));
+    meta_data mdata(V, g->edge_count, width, g->new_vert_count);
+    gpu_graph ggraph(g.get());
+    ggraph.merge_groups_d = merge_groups;
+    ggraph.merge_pointer_d = merge_offsets;
+    cb_reducer select_push, select_pull;
+    best_reducer select_best;
+    cb_mapper map_push, map_pull;
+    H_ERR(cudaMemcpyFromSymbol(&select_push, vert_selector_push_d, sizeof(select_push)));
+    H_ERR(cudaMemcpyFromSymbol(&select_pull, vert_selector_pull_d, sizeof(select_pull)));
+    H_ERR(cudaMemcpyFromSymbol(&select_best, vertex_selector_best_push_d, sizeof(select_best)));
+    H_ERR(cudaMemcpyFromSymbol(&map_push, vert_behave_push_d, sizeof(map_push)));
+    H_ERR(cudaMemcpyFromSymbol(&map_pull, vert_behave_pull_d, sizeof(map_pull)));
+    mapper compute(ggraph, mdata, map_push, map_pull, width);
+    reducer gather(ggraph, mdata, select_push, select_pull, select_best, width);
+    Barrier barrier(BLKS_NUM);
+    std::vector<feature_t> tree(states), queued(states), singleton(states);
+    std::vector<feature_t> w(static_cast<size_t>(G)*G*width), w1(static_cast<size_t>(G)*width), vv(G*G);
+    std::vector<int> members;
+    feature_t levels[10];
+    for (int q = first; q <= last; ++q) {
+        double start_time = wtime();
+        std::fill(tree.begin(),tree.end(),inf);
+        H_ERR(cudaMemcpy(mdata.vert_status_prev, tree.data(), states*sizeof(feature_t), cudaMemcpyHostToDevice));
+        members.clear();
+        set_max_ID(g->group_graph, g->inquire[q], tree.data(), members, width);
+        H_ERR(cudaMemcpy(mdata.vert_status, tree.data(), states*sizeof(feature_t), cudaMemcpyHostToDevice));
+        H_ERR(cudaMemset(level, 0, 10*sizeof(feature_t)));
+        mapper_hybrid_push_merge(512, level, ggraph, mdata, compute, gather, barrier, 1);
+        H_ERR(cudaMemcpy(mdata.record, mdata.vert_status, states*sizeof(feature_t), cudaMemcpyDeviceToDevice));
+        H_ERR(cudaMemcpy(singleton.data(), mdata.record, states*sizeof(feature_t), cudaMemcpyDeviceToHost));
+        // Root/group shortest paths supply the original TrimCDP lower bounds.
+        std::fill(vv.begin(),vv.end(),inf);
+        std::fill(w.begin(),w.end(),inf);
+        std::fill(w1.begin(),w1.end(),inf);
+        for (int v = 0; v < V; ++v)
+            for (int i = 0; i < G; ++i)
+                if (singleton[v*width+(1<<i)] == 0)
+                    for (int j = 0; j < G; ++j)
+                        vv[i*G+j] = std::min(vv[i*G+j],singleton[v*width+(1<<j)]);
+        for (int i = 0; i < G; ++i)
+            for (int j = 0; j < G; ++j) w[(i*G+j)*width] = vv[i*G+j];
+        for (int mask = 1; mask < width; ++mask)
+            for (int i = 0; i < G; ++i)
+                for (int j = 0; j < G; ++j) {
+                    int middle = mask & ~(1<<i) & ~(1<<j);
+                    auto& cost = w[(i*G+j)*width+mask];
+                    if (!middle) cost = vv[i*G+j];
+                    for (int k = 0; k < G; ++k)
+                        if (middle & (1<<k)) cost = std::min(cost, w[(i*G+k)*width+(middle^(1<<k))]+vv[k*G+j]);
+                }
+        for (int i = 0; i < G; ++i)
+            for (int mask = 1; mask < width; ++mask)
+                for (int j = 0; j < G; ++j) w1[i*width+mask] = std::min(w1[i*width+mask], w[(i*G+j)*width+mask]);
+        H_ERR(cudaMemcpy(w_d, w.data(), w.size()*sizeof(feature_t), cudaMemcpyHostToDevice));
+        H_ERR(cudaMemcpy(w1_d, w1.data(), w1.size()*sizeof(feature_t), cudaMemcpyHostToDevice));
+        *can_find = 0;
+        one_label_lb_1<<<(V+511)/512,512>>>(mdata.record,width,mdata.lb0,V,G,can_find,w_d,w1_d);
+        H_ERR(cudaGetLastError());
+        H_ERR(cudaDeviceSynchronize());
+        std::fill(tree.begin(),tree.end(),inf);
+        H_ERR(cudaMemcpy(mdata.vert_status_prev, tree.data(), states*sizeof(feature_t), cudaMemcpyHostToDevice));
+        std::fill(queued.begin(),queued.end(),0);
+        members.clear();
+        set_max_ID(g->group_graph, g->inquire[q], tree.data(), members, width);
+        for (int v : members) {
+            int mask = get_max(v,tree.data(),width);
+            for (int sub = mask; sub; sub = (sub-1)&mask) {
+                tree[v*width+sub] = 0;
+                queued[v*width+sub] = 1;
+            }
+        }
+        H_ERR(cudaMemcpy(mdata.vert_status, tree.data(), states*sizeof(feature_t), cudaMemcpyHostToDevice));
+        H_ERR(cudaMemcpy(mdata.in_queue, queued.data(), states*sizeof(feature_t), cudaMemcpyHostToDevice));
+        feature_t cost = inf;
+        std::fill(std::begin(levels),std::end(levels),0);
+        *set_num = 0;
+        if (*can_find) {
+            balanced_push(512,level,ggraph,mdata,compute,gather,barrier);
+            H_ERR(cudaMemcpy(tree.data(), mdata.vert_status, states*sizeof(feature_t), cudaMemcpyDeviceToHost));
+            H_ERR(cudaMemcpy(levels, level, sizeof(levels), cudaMemcpyDeviceToHost));
+            for (int v = 0; v < V; ++v) cost = std::min(cost,tree[v*width+width-1]);
+            count_used<<<(V+511)/512,512>>>(mdata.vert_status,width,set_num,V);
+            H_ERR(cudaGetLastError());
+            H_ERR(cudaDeviceSynchronize());
+        }
+        double elapsed = wtime()-start_time;
+        std::string result = cost == inf ? "infeasible" : std::to_string(cost);
+        if (want_witness && cost != inf) print_witness(q,cost,decode_witness(*g,g->inquire[q],width,tree,singleton,cost));
+        std::cout << "query " << q << "\nmin cost " << result << "\ntime " << elapsed << "\n";
+        output << q << ',';
+        for (int id : g->inquire[q]) output << id << ' ';
+        output << ',' << elapsed << ',' << result << ',' << (levels[5]+states+*set_num)
+               << ',' << *set_num << ',' << levels[6] << '\n';
+    }
+    mdata.release();
+    ggraph.release();
+    for (void* pointer : std::initializer_list<void*>{merge_groups,merge_offsets,w_d,w1_d,level,can_find,set_num}) H_ERR(cudaFree(pointer));
+    output.close();
+    if (!output) throw std::runtime_error("cannot finish writing result CSV");
+    return 0;
+}
+int main(int argc, char** argv) {
+    try { return run_gpu4gst(argc,argv); }
+    catch (const std::exception& error) { std::cerr << "GPU4GST: " << error.what() << '\n'; return 2; }
 }
