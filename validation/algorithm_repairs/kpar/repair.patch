 static void init_parameter(Config &config, const Graph &graph) {
+	// Bind offline samples to the exact directed multigraph.
+	unll signature = 14695981039346656037ULL;
+	auto mix = [&](unsigned int value) {
+		for (int i = 0; i < 4; ++i) {
+			signature = (signature ^ (value & 255)) * 1099511628211ULL;
+			value >>= 8;
+		}
+	};
+	mix(graph.num_vertices);
+	mix(graph.num_edges);
+	for (int v = 0; v < graph.num_vertices; ++v) {
+		mix(graph.degrees[v]);
+		for (int neighbor : graph.g[v]) mix(neighbor);
+	}
+	config.graph_signature = signature;
 	config.delta = 1.0 / (ValueType) graph.num_vertices;
 	config.pre_delta = 1.0 / (ValueType) graph.num_vertices;
 	config.pfail = 1.0 / (ValueType) graph.num_vertices;
 	config.dbar = ValueType(graph.num_edges) / ValueType(graph.num_vertices);
 }
 
