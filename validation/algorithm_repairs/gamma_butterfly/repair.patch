+++ b/sm_input.h
@@ -0,0 +1,49 @@
+#pragma once
+#include <fstream>
+#include <vector>
+#include <stdexcept>
+#include <limits>
+
+// Validate the binary CSR before the legacy loader copies it to CUDA memory.
+template<typename T>
+std::vector<T> read_sm_binary(std::ifstream& in, uint64_t count) {
+    if (count > std::numeric_limits<size_t>::max()/sizeof(T)) throw std::runtime_error("input is too large");
+    const auto begin = in.tellg();
+    in.seekg(0,std::ios::end);
+    const auto end = in.tellg();
+    if (begin < 0 || end < begin || uint64_t(end-begin) != count*sizeof(T))
+        throw std::runtime_error("truncated or oversized binary graph file");
+    in.seekg(begin);
+    std::vector<T> data(count);
+    if (count && !in.read(reinterpret_cast<char*>(data.data()),count*sizeof(T)))
+        throw std::runtime_error("cannot read graph data");
+    return data;
+}
+
+uint32_t validate_sm_graph(const std::string& prefix) {
+    std::ifstream col(prefix+".col",std::ios::binary), dst(prefix+".dst",std::ios::binary), labels(prefix+".vlabel",std::ios::binary);
+    uint32_t n=0, label_n=0;
+    uint64_t m=0;
+    if (!col.read(reinterpret_cast<char*>(&n),sizeof(n)) || n==UINT32_MAX ||
+        !dst.read(reinterpret_cast<char*>(&m),sizeof(m)) ||
+        !labels.read(reinterpret_cast<char*>(&label_n),sizeof(label_n)) || label_n!=n)
+        throw std::runtime_error("missing or invalid CSR/label header");
+    const auto offsets=read_sm_binary<uint64_t>(col,uint64_t(n)+1);
+    const auto edges=read_sm_binary<uint32_t>(dst,m);
+    read_sm_binary<uint8_t>(labels,n);
+    if (offsets.front()!=0 || offsets.back()!=m) throw std::runtime_error("invalid CSR endpoints");
+    for (uint32_t v=0; v<n; ++v) {
+        if (offsets[v]>offsets[v+1] || offsets[v+1]>m || offsets[v+1]-offsets[v]>UINT32_MAX)
+            throw std::runtime_error("invalid CSR row offsets");
+        for (uint64_t j=offsets[v]; j<offsets[v+1]; ++j)
+            if (edges[j]>=n || edges[j]==v || (j>offsets[v] && edges[j]<=edges[j-1]))
+                throw std::runtime_error("CSR rows must be sorted, unique, loop-free and in range");
+    }
+    for (uint32_t v=0; v<n; ++v)
+        for (uint64_t j=offsets[v]; j<offsets[v+1]; ++j) {
+            const uint32_t u=edges[j];
+            if (!std::binary_search(edges.begin()+offsets[u],edges.begin()+offsets[u+1],v))
+                throw std::runtime_error("data graph must be undirected");
+        }
+    return n;
+}
