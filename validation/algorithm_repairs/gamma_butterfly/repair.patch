new file mode 100644
index 0000000..c250083
--- /dev/null
+++ b/checked_expand.cuh
@@ -0,0 +1,43 @@
+#pragma once
+#include <limits>
+#include <stdexcept>
+#include "expand.cuh"
+
+struct CheckedCountSum {
+    __host__ __device__ emb_off_type operator()(emb_off_type a, emb_off_type b) const {
+        return ~emb_off_type(0) - a < b ? ~emb_off_type(0) : a + b;
+    }
+};
+
+// Use GAMMA's full injectivity/label/adjacency validator in both passes.
+// The final level is reduced without materializing its embeddings.
+emb_off_type expand_checked(CSRGraph& graph, EmbeddingList& embeddings, unsigned level,
+                            expand_constraint constraints, bool write_back) {
+    const emb_off_type count = embeddings.size(level - 1);
+    if (!count) return 0;
+    if (count > std::numeric_limits<uint32_t>::max())
+        throw std::runtime_error("intermediate frontier exceeds the kernel's 32-bit input range");
+    emb_off_type* offsets = nullptr;
+    check_cuda_error(cudaMalloc(&offsets, (count + 1) * sizeof(emb_off_type)));
+    check_cuda_error(cudaMemset(offsets, 0, (count + 1) * sizeof(emb_off_type)));
+    const unsigned blocks = std::min<emb_off_type>(4096, (count + BLOCK_SIZE/32 - 1)/(BLOCK_SIZE/32));
+    extend_alloc<<<blocks,BLOCK_SIZE>>>(embeddings, level-1, graph, constraints, offsets, 0, count);
+    check_cuda_error(cudaGetLastError());
+    thrust::exclusive_scan(thrust::device, offsets, offsets + count + 1, offsets,
+                           emb_off_type(0), CheckedCountSum());
+    emb_off_type result = 0;
+    check_cuda_error(cudaMemcpy(&result, offsets + count, sizeof(result), cudaMemcpyDeviceToHost));
+    if (result == ~emb_off_type(0)) {
+        check_cuda_error(cudaFree(offsets));
+        throw std::runtime_error("embedding count exceeds 64-bit range");
+    }
+    if (write_back && result) {
+        embeddings.add_level(result, level);
+        extend_insert_indevice<<<blocks,BLOCK_SIZE>>>(embeddings, level-1, graph, constraints, offsets, 0, count,
+            embeddings.get_vid_list_by_mem_controller()[level], embeddings.get_idx_list_by_mem_controller()[level]);
+        check_cuda_error(cudaGetLastError());
+        check_cuda_error(cudaDeviceSynchronize());
+    }
+    check_cuda_error(cudaFree(offsets));
+    return result;
+}
