+    void readFromFile(const char* filename) {
+        clear();
+        std::ifstream input(filename);
+        if (!(input >> vertex_num) || vertex_num == 0 || vertex_num > embedding_max_length)
+            throw std::runtime_error("query size must be between 1 and 7");
+        vertex_label.resize(vertex_num);
+        adj_list.resize(vertex_num); order_list.resize(vertex_num);
+        for (auto& label : vertex_label) {
+            unsigned value;
+            if (!(input >> value) || value > 255) throw std::runtime_error("invalid query label");
+            label = value;
+        }
+        auto read_rows = [&](std::vector<std::vector<uint32_t>>& rows) {
+            for (unsigned v = 0; v < vertex_num; ++v) {
+                unsigned count;
+                if (!(input >> count) || count >= vertex_num) throw std::runtime_error("invalid query row size");
+                std::set<unsigned> seen;
+                for (unsigned i = 0; i < count; ++i) {
+                    unsigned neighbor;
+                    if (!(input >> neighbor) || neighbor >= vertex_num || neighbor == v || !seen.insert(neighbor).second)
+                        throw std::runtime_error("invalid query neighbor");
+                    rows[v].push_back(neighbor);
+                }
+                std::sort(rows[v].begin(), rows[v].end());
+            }
+        };
+        read_rows(adj_list); read_rows(order_list);
+        std::string extra;
+        if (input >> extra) throw std::runtime_error("unexpected query data");
+        for (unsigned v = 0; v < vertex_num; ++v) {
+            for (unsigned u : adj_list[v])
+                if (!std::binary_search(adj_list[u].begin(), adj_list[u].end(), v))
+                    throw std::runtime_error("query adjacency must be symmetric");
+            core.push_back(v); // Match leaves and isolated query vertices too.
+        }
+        // Ordering pairs constrain the later vertex by (degree, ID), as in GAMMA.
+        std::set<std::pair<unsigned,unsigned>> ordering;
+        for (unsigned v = 0; v < vertex_num; ++v)
+            for (unsigned u : order_list[v]) ordering.insert(std::minmax(v,u));
+        order_list.assign(vertex_num, {});
+        for (auto pair : ordering) order_list[pair.second].push_back(pair.first);
+    }
+    void clear() {
+        vertex_num=0; vertex_label.clear(); adj_list.clear(); order_list.clear(); core.clear(); satellite.clear();
+    }
 };
