+++ b/cudaCode/inc/exactFlow.cuh
@@ -0,0 +1,187 @@
+#pragma once
+
+#include <numeric>
+#include <stdexcept>
+
+// Capacities are integers throughout. At density p/q the existing CDS
+// reduction has cut capacity k*q*C - k*(q*C(S) - p*|S|).
+// Kernel boundaries separate initialization, pushes and height updates.
+namespace cds_exact {
+
+__global__ void initialize(deviceFlowNetworkPointers f, ui vertices, ui nodes) {
+  for (ui u = blockIdx.x * blockDim.x + threadIdx.x; u < nodes;
+       u += blockDim.x * gridDim.x) {
+    f.height[u] = u == nodes - 2 ? nodes : (u < vertices ? 1 : 0);
+    f.excess[u] = 0;
+  }
+}
+
+__global__ void saturateSource(deviceFlowNetworkPointers f, ui vertices,
+                               ui source) {
+  for (ui u = blockIdx.x * blockDim.x + threadIdx.x; u < vertices;
+       u += blockDim.x * gridDim.x) {
+    ui edge = f.offset[source] + u;
+    FlowCapacity value = f.capacity[edge];
+    f.flow[edge] = 0;
+    f.flow[f.flowIndex[edge]] = value;
+    f.excess[u] = value;
+  }
+}
+
+__global__ void push(deviceFlowNetworkPointers f, ui nodes) {
+  for (ui u = blockIdx.x * blockDim.x + threadIdx.x; u < nodes - 2;
+       u += blockDim.x * gridDim.x) {
+    // Other vertices may send excess to u during this phase. Only u spends
+    // its excess. Frozen heights prevent simultaneous opposite pushes.
+    FlowCapacity available = atomicAdd(f.excess + u, 0ULL);
+    for (ui e = f.offset[u]; available && e < f.offset[u + 1]; ++e) {
+      ui v = f.neighbors[e];
+      if (f.height[u] != f.height[v] + 1) continue;
+      FlowCapacity residual = atomicAdd(f.flow + e, 0ULL);
+      FlowCapacity amount = available < residual ? available : residual;
+      if (!amount) continue;
+      atomicAdd(f.flow + e, 0ULL - amount);
+      atomicAdd(f.flow + f.flowIndex[e], amount);
+      atomicAdd(f.excess + u, 0ULL - amount);
+      atomicAdd(f.excess + v, amount);
+      available -= amount;
+    }
+  }
+}
+
+__global__ void relabel(deviceFlowNetworkPointers f, ui nodes, ui *nextHeight,
+                        ui *active) {
+  for (ui u = blockIdx.x * blockDim.x + threadIdx.x; u < nodes;
+       u += blockDim.x * gridDim.x) {
+    ui height = f.height[u];
+    if (u < nodes - 2 && f.excess[u]) {
+      ui minimum = UINT_MAX;
+      for (ui e = f.offset[u]; e < f.offset[u + 1]; ++e)
+        if (f.flow[e]) minimum = min(minimum, f.height[f.neighbors[e]]);
+      assert(minimum != UINT_MAX);
+      height = minimum + 1;
+      assert(height >= f.height[u] && height < 2ULL * nodes);
+      atomicExch(active, 1U);
+    }
+    nextHeight[u] = height;
+  }
+}
+
+__global__ void reach(deviceFlowNetworkPointers f, ui nodes, ui *reachable,
+                      ui *changed) {
+  for (ui u = blockIdx.x * blockDim.x + threadIdx.x; u < nodes;
+       u += blockDim.x * gridDim.x) {
+    if (!atomicAdd(reachable + u, 0U)) continue;
+    for (ui e = f.offset[u]; e < f.offset[u + 1]; ++e)
+      if (f.flow[e] && atomicCAS(reachable + f.neighbors[e], 0U, 1U) == 0)
+        atomicExch(changed, 1U);
+  }
+}
+
+__global__ void resetDistances(deviceFlowNetworkPointers f, ui nodes) {
+  for (ui u = blockIdx.x * blockDim.x + threadIdx.x; u < nodes;
+       u += blockDim.x * gridDim.x)
+    f.height[u] = u == nodes - 1 ? 0 : (u == nodes - 2 ? nodes : 2 * nodes);
+}
+
+__global__ void relaxDistances(deviceFlowNetworkPointers f, ui nodes, ui *changed) {
+  for (ui u = blockIdx.x * blockDim.x + threadIdx.x; u < nodes - 2;
+       u += blockDim.x * gridDim.x) {
+    ui distance = atomicAdd(f.height + u, 0U);
+    for (ui e = f.offset[u]; e < f.offset[u + 1]; ++e)
+      if (f.flow[e])
+        distance = min(distance, atomicAdd(f.height + f.neighbors[e], 0U) + 1);
+    if (atomicMin(f.height + u, distance) > distance) atomicExch(changed, 1U);
+  }
+}
+
+struct FlowResult {
+  FlowCapacity value;
+  size_t rounds;
+  std::vector<ui> selected;
+};
+
+inline FlowResult maxflow(deviceFlowNetworkPointers &f, ui vertices, ui nodes,
+                          FlowCapacity sourceCapacity) {
+  const ui threads = 128;
+  const ui blocks = std::min(1024U, (nodes + threads - 1) / threads);
+  ui *nextHeight, *active, *reachable;
+  chkerr(cudaMalloc((void **)&nextHeight, size_t(nodes) * sizeof(ui)));
+  chkerr(cudaMalloc((void **)&active, sizeof(ui)));
+  chkerr(cudaMalloc((void **)&reachable, size_t(nodes) * sizeof(ui)));
+  initialize<<<blocks, threads>>>(f, vertices, nodes);
+  saturateSource<<<blocks, threads>>>(f, vertices, nodes - 2);
+  ui hostActive = 1;
+  size_t rounds = 0;
+  while (hostActive) {
+    if (rounds % 128 == 0) {
+      // Exact residual distances to the sink, or to the source plus nodes,
+      // accelerate both delivery and the return of excess from a cut.
+      resetDistances<<<blocks, threads>>>(f, nodes);
+      ui changed = 1;
+      while (changed) {
+        chkerr(cudaMemset(active, 0, sizeof(ui)));
+        relaxDistances<<<blocks, threads>>>(f, nodes, active);
+        chkerr(cudaGetLastError());
+        chkerr(cudaMemcpy(&changed, active, sizeof(ui), cudaMemcpyDeviceToHost));
+      }
+    }
+    // Checking every eight rounds reduces transfers. Once there is no active
+    // vertex, subsequent rounds leave the completed flow unchanged.
+    for (int step = 0; step < 8; ++step) {
+      push<<<blocks, threads>>>(f, nodes);
+      chkerr(cudaMemset(active, 0, sizeof(ui)));
+      relabel<<<blocks, threads>>>(f, nodes, nextHeight, active);
+      std::swap(f.height, nextHeight);
+      ++rounds;
+    }
+    chkerr(cudaGetLastError());
+    chkerr(cudaMemcpy(&hostActive, active, sizeof(ui), cudaMemcpyDeviceToHost));
+  }
+  FlowCapacity terminalExcess[2];
+  chkerr(cudaMemcpy(terminalExcess, f.excess + nodes - 2,
+                    sizeof(terminalExcess), cudaMemcpyDeviceToHost));
+  if (terminalExcess[0] > sourceCapacity ||
+      terminalExcess[1] != sourceCapacity - terminalExcess[0])
+    throw std::runtime_error("Flow conservation check failed");
+  FlowResult result{terminalExcess[1], rounds, {}};
+  if (result.value < sourceCapacity) {
+    chkerr(cudaMemset(reachable, 0, size_t(nodes) * sizeof(ui)));
+    ui one = 1;
+    chkerr(cudaMemcpy(reachable + nodes - 2, &one, sizeof(ui), cudaMemcpyHostToDevice));
+    hostActive = 1;
+    while (hostActive) {
+      chkerr(cudaMemset(active, 0, sizeof(ui)));
+      reach<<<blocks, threads>>>(f, nodes, reachable, active);
+      chkerr(cudaGetLastError());
+      chkerr(cudaMemcpy(&hostActive, active, sizeof(ui), cudaMemcpyDeviceToHost));
+    }
+    std::vector<ui> reached(nodes);
+    chkerr(cudaMemcpy(reached.data(), reachable, size_t(nodes) * sizeof(ui),
+                      cudaMemcpyDeviceToHost));
+    if (reached.back()) throw std::runtime_error("Residual source-to-sink path remains");
+    for (ui u = 0; u < vertices; ++u)
+      if (reached[u]) result.selected.push_back(u);
+  }
+  chkerr(cudaFree(nextHeight));
+  chkerr(cudaFree(active));
+  chkerr(cudaFree(reachable));
+  return result;
+}
+
+inline void printResult(ui k, ui count, std::vector<ui> selected,
+                        size_t decisions = 0) {
+  std::sort(selected.begin(), selected.end());
+  double density = selected.empty() ? 0.0 : double(count) / selected.size();
+  std::cout << std::setprecision(17) << "Final Max Density " << density << '\n';
+  std::cout << "CDS_RESULT {\"k\":" << k << ",\"density\":" << density
+            << ",\"clique_count\":" << count << ",\"vertex_count\":" << selected.size()
+            << ",\"optimal\":true,\"flow_decisions\":" << decisions << ",\"vertices\":[";
+  for (size_t i = 0; i < selected.size(); ++i) {
+    if (i) std::cout << ',';
+    std::cout << selected[i];
+  }
+  std::cout << "]}" << std::endl;
+}
+
+} // namespace cds_exact
