{
  "$defs": {
    "AnalysisTask": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "problem_id": {
          "title": "Problem Id",
          "type": "string"
        },
        "question": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "problem_id",
        "operation_id"
      ],
      "title": "AnalysisTask",
      "type": "object"
    },
    "ApplicationIntent": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Assumptions",
          "type": "array"
        },
        "entity_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Type"
        },
        "filter_mode": {
          "default": "inherit",
          "enum": [
            "inherit",
            "replace",
            "clear"
          ],
          "title": "Filter Mode",
          "type": "string"
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/DataFilter"
          },
          "maxItems": 12,
          "title": "Filters",
          "type": "array"
        },
        "objective": {
          "default": "",
          "maxLength": 1500,
          "title": "Objective",
          "type": "string"
        },
        "pattern_edges": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "maxItems": 30,
          "title": "Pattern Edges",
          "type": "array"
        },
        "pattern_vertex_count": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern Vertex Count"
        },
        "relationship_meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relationship Meaning"
        },
        "requires_direction": {
          "default": false,
          "title": "Requires Direction",
          "type": "boolean"
        },
        "requires_edge_weights": {
          "default": false,
          "title": "Requires Edge Weights",
          "type": "boolean"
        },
        "time_unit": {
          "default": "unspecified",
          "enum": [
            "seconds",
            "milliseconds",
            "native",
            "unspecified"
          ],
          "title": "Time Unit",
          "type": "string"
        },
        "time_window": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Window"
        },
        "weight_attribute": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Attribute"
        },
        "weight_usage": {
          "anyOf": [
            {
              "enum": [
                "path_length",
                "strength",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Usage"
        }
      },
      "title": "ApplicationIntent",
      "type": "object"
    },
    "DataFilter": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte",
            "in"
          ],
          "title": "Operator",
          "type": "string"
        },
        "target": {
          "enum": [
            "vertices",
            "edges"
          ],
          "title": "Target",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "target",
        "field",
        "operator",
        "value"
      ],
      "title": "DataFilter",
      "type": "object"
    },
    "DataInspection": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Fields",
          "type": "array"
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/DataFilter"
          },
          "maxItems": 6,
          "title": "Filters",
          "type": "array"
        },
        "limit": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "target": {
          "enum": [
            "vertices",
            "edges"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "title": "DataInspection",
      "type": "object"
    },
    "ExecutionPlan": {
      "additionalProperties": false,
      "properties": {
        "allow_directed_projection": {
          "default": false,
          "title": "Allow Directed Projection",
          "type": "boolean"
        },
        "application_intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApplicationIntent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "auxiliary_inputs": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Exact program_instruction.auxiliary_inputs keys mapped to matching available file IDs.",
          "title": "Auxiliary Inputs",
          "type": "object"
        },
        "backend_id": {
          "default": "auto",
          "description": "Exact backend ID from the selected operation, or auto.",
          "title": "Backend Id",
          "type": "string"
        },
        "collect_statistics": {
          "default": true,
          "title": "Collect Statistics",
          "type": "boolean"
        },
        "graph_id": {
          "title": "Graph Id",
          "type": "string"
        },
        "missing_inputs": {
          "items": {
            "type": "string"
          },
          "title": "Missing Inputs",
          "type": "array"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "optional_outputs": {
          "description": "Exact requested keys from program_instruction.optional_outputs; do not put output behaviors in parameters.",
          "items": {
            "type": "string"
          },
          "title": "Optional Outputs",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Only exact keys from program_instruction.parameters; null means the optional CLI flag is omitted.",
          "title": "Parameters",
          "type": "object"
        },
        "problem_id": {
          "title": "Problem Id",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "maxLength": 1200,
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "graph_id",
        "problem_id",
        "operation_id"
      ],
      "title": "ExecutionPlan",
      "type": "object"
    },
    "RouteDecision": {
      "additionalProperties": false,
      "properties": {
        "additional_analyses": {
          "items": {
            "$ref": "#/$defs/AnalysisTask"
          },
          "maxItems": 3,
          "title": "Additional Analyses",
          "type": "array"
        },
        "ambiguity": {
          "description": "Only unresolved user choices phrased as questions. Empty for multiple clear, independently answerable questions.",
          "items": {
            "type": "string"
          },
          "title": "Ambiguity",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "explanation": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "inspections": {
          "items": {
            "$ref": "#/$defs/DataInspection"
          },
          "maxItems": 2,
          "title": "Inspections",
          "type": "array"
        },
        "intent": {
          "$ref": "#/$defs/ApplicationIntent"
        },
        "missing_information": {
          "items": {
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact runnable operation for a supported problem; null for an unsupported, ambiguous, or unrecognized request.",
          "title": "Operation Id"
        },
        "problem_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact formal problem ID when intent is recognized, including an unsupported problem; null only for ambiguous or unrecognized intent.",
          "title": "Problem Id"
        },
        "supported": {
          "description": "True only when the selected problem has library_support.status equal to 'validated' and exposes the selected operation.",
          "title": "Supported",
          "type": "boolean"
        }
      },
      "required": [
        "supported",
        "confidence",
        "explanation"
      ],
      "title": "RouteDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision": {
      "$ref": "#/$defs/RouteDecision"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plans": {
      "items": {
        "$ref": "#/$defs/ExecutionPlan"
      },
      "title": "Plans",
      "type": "array"
    },
    "status": {
      "default": "needs_information",
      "enum": [
        "ready",
        "needs_information",
        "unsupported"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "message",
    "decision"
  ],
  "title": "PlanningOutcome",
  "type": "object"
}
