# Copy to .env and verify UUIDs with: nvidia-smi -L
GRAPHMINE_API_HOST=0.0.0.0
GRAPHMINE_API_PORT=8000
# Legacy private-LAN mode only; ignored while accounts are enabled.
GRAPHMINE_API_TOKEN=replace-with-a-long-random-value
GRAPHMINE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Accounts are created only by the server operator, using deploy/manage-accounts.sh.
# Keep Secure cookies enabled for an HTTPS domain/tunnel. For local HTTP testing
# only, set GRAPHMINE_ACCOUNT_COOKIE_SECURE=false. There is no public signup.
GRAPHMINE_ACCOUNTS_ENABLED=true
GRAPHMINE_ACCOUNT_COOKIE_SECURE=true
GRAPHMINE_ACCOUNT_SESSION_SECONDS=86400
GRAPHMINE_MAX_ACCOUNTS=100
# Persistent 24-hour budgets: both the user and shared server limits apply.
GRAPHMINE_ACCOUNT_DAILY_TOKENS=50000
GRAPHMINE_SERVER_DAILY_TOKENS=1000000
GRAPHMINE_ACCOUNT_DAILY_JOBS=10
GRAPHMINE_SERVER_DAILY_JOBS=100
# Aggregate limits across both workspaces; one model call/pending job per user.
GRAPHMINE_MAX_MODEL_CALLS=2
GRAPHMINE_ACCOUNT_PENDING_JOBS=8
GRAPHMINE_ACCOUNT_RUNNING_JOBS=1
GRAPHMINE_ACCOUNT_JOB_SECONDS=300
# Per-account raw uploaded-file budget, and maximum size of one upload.
GRAPHMINE_ACCOUNT_STORAGE_BYTES=536870912
GRAPHMINE_ACCOUNT_UPLOAD_BYTES=67108864

# Keep one physical GPU dedicated to each role. Inside either process it is device 0.
GRAPHMINE_LLM_GPU_UUID=GPU-177a4150-e6ff-62d9-810f-166fe6a4575b
GRAPHMINE_GRAPH_GPU_UUID=GPU-f9f2c156-0de4-a1f3-0c8a-a77ca24d10f7
# Shared-GPU deployments must also reserve memory through the model server's utilization setting.
GRAPHMINE_ALLOW_SHARED_GPU=false

GRAPHMINE_LLM_ENABLED=true
GRAPHMINE_LLM_BASE_URL=http://127.0.0.1:8001/v1
GRAPHMINE_LLM_API_KEY=local-graphmine
GRAPHMINE_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
# Optional exact repository commit, shared by the model and tokenizer.
GRAPHMINE_LLM_REVISION=
# Two stage adapters share the above loaded base. Configure both aliases together.
GRAPHMINE_LLM_PLANNER_MODEL=
GRAPHMINE_LLM_ANALYST_MODEL=
GRAPHMINE_LLM_PLANNER_ADAPTER_PATH=
GRAPHMINE_LLM_ANALYST_ADAPTER_PATH=
GRAPHMINE_LLM_PLANNER_ADAPTER_SHA256=
GRAPHMINE_LLM_ANALYST_ADAPTER_SHA256=
# Optional separate, verified routing adapter; blank uses the base model.
GRAPHMINE_ROUTER_BASE_URL=
GRAPHMINE_ROUTER_MODEL=graphmine-business-v1
GRAPHMINE_ROUTER_ADAPTER_SHA256=
# Explicit opt-in: use the saved adapter with the current expanded prompt/catalog.
# Its previous routing scores cover legacy-20 only; expanded accuracy is unmeasured.
GRAPHMINE_ROUTER_ALLOW_EXPANDED_CATALOG=false
GRAPHMINE_DEPLOYMENT_VERSION=base
# GRAPHMINE_ROUTER_SUITE=/absolute/path/to/verified-routing-suite
# Conservative single-server defaults; raise only after measuring memory use.
GRAPHMINE_LLM_MAX_MODEL_LEN=32768
GRAPHMINE_LLM_MAX_NUM_SEQS=2
GRAPHMINE_LLM_GPU_MEMORY_UTILIZATION=0.88
# Qwen skill budgets: bounded routing, deliberate plans, deliberate analysis.
GRAPHMINE_LLM_ROUTE_REASONING_EFFORT=none
GRAPHMINE_LLM_PLAN_REASONING_EFFORT=medium
GRAPHMINE_LLM_ANALYST_REASONING_EFFORT=medium
GRAPHMINE_LLM_ROUTE_MAX_TOKENS=768
GRAPHMINE_LLM_PLAN_MAX_TOKENS=3072
GRAPHMINE_LLM_ANALYST_MAX_TOKENS=3072

GRAPHMINE_AGENT_DATA_ROOT=.graphmine-agent
# Optional history location; default is <data root>/history (CLI: .graphmine-cli/history).
# GRAPHMINE_HISTORY_ROOT=/absolute/path/to/local-history
GRAPHMINE_BINARY=library/build/graphmine
# CSV/edge-list uploads use the native libcudf reader on GRAPHMINE_GRAPH_GPU_UUID.
GRAPHMINE_NATIVE_BINARY=library/build/runtime/graphmine-native
GRAPHMINE_NATIVE_LIBRARY=library/build/runtime/libgraphmine_runtime.so
# Native workflow planning uses the base model unless a compatible adapter is set.
# Legacy V1 planner adapters use a different schema.
GRAPHMINE_ANALYTICS_PLANNER_MODEL=
GRAPHMINE_ANALYTICS_REASONING_EFFORT=medium
# Optional vLLM extension; blank omits it for other compatible model servers.
# Leave room within GRAPHMINE_LLM_PLAN_MAX_TOKENS for the final structured plan.
GRAPHMINE_ANALYTICS_THINKING_TOKEN_BUDGET=1536
# Optional additional GPU UUIDs admitted by the analytics scheduler.
GRAPHMINE_ANALYTICS_GPU_UUIDS=
GRAPHMINE_ANALYTICS_CPU_WORKERS=2
GRAPHMINE_ANALYTICS_GPU_HEADROOM_BYTES=536870912
# With explicit shared-GPU permission, 0 reserves 80% of the LLM device.
GRAPHMINE_ANALYTICS_LLM_RESERVE_BYTES=0
GRAPHMINE_BACKEND_POLICY=agent/backend_policy.json
GRAPHMINE_MAX_UPLOAD_BYTES=2147483648
# Bound simultaneous in-memory graph parsing. Excess uploads receive HTTP 429.
GRAPHMINE_MAX_CONCURRENT_UPLOADS=2
# Queued, running and interpreting jobs share this admission limit.
GRAPHMINE_MAX_PENDING_JOBS=64
# Larger native result files fail explicitly and remain in the job workspace.
GRAPHMINE_MAX_RESULT_BYTES=67108864
GRAPHMINE_JOB_TIMEOUT_SECONDS=86400
GRAPHMINE_RESULT_SUMMARY_ITEMS=50

# For hardened systemd deployments, point these at /var/lib/graphmine.
HF_HOME=.graphmine-agent/huggingface
XDG_CACHE_HOME=.graphmine-agent/cache
VLLM_CACHE_ROOT=.graphmine-agent/vllm-cache
