# Copy to .env, replace the token, and verify UUIDs with: nvidia-smi -L
GRAPHMINE_API_HOST=0.0.0.0
GRAPHMINE_API_PORT=8000
GRAPHMINE_API_TOKEN=replace-with-a-long-random-value
GRAPHMINE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Keep one physical GPU dedicated to each role. Inside either process it is device 0.
GRAPHMINE_LLM_GPU_UUID=GPU-177a4150-e6ff-62d9-810f-166fe6a4575b
GRAPHMINE_GRAPH_GPU_UUID=GPU-f9f2c156-0de4-a1f3-0c8a-a77ca24d10f7

GRAPHMINE_LLM_ENABLED=true
GRAPHMINE_LLM_BASE_URL=http://127.0.0.1:8001/v1
GRAPHMINE_LLM_API_KEY=local-graphmine
GRAPHMINE_LLM_MODEL=Qwen/Qwen3.8-27B-FP8
# Conservative single-server defaults; raise only after measuring memory use.
GRAPHMINE_LLM_MAX_MODEL_LEN=32768
GRAPHMINE_LLM_MAX_NUM_SEQS=64
GRAPHMINE_LLM_GPU_MEMORY_UTILIZATION=0.88
# Qwen skill budgets: bounded routing, deliberate plans, deliberate analysis.
GRAPHMINE_LLM_ROUTE_REASONING_EFFORT=none
GRAPHMINE_LLM_PLAN_REASONING_EFFORT=medium
GRAPHMINE_LLM_ANALYST_REASONING_EFFORT=medium
GRAPHMINE_LLM_ROUTE_MAX_TOKENS=768
GRAPHMINE_LLM_PLAN_MAX_TOKENS=3072
GRAPHMINE_LLM_ANALYST_MAX_TOKENS=3072

GRAPHMINE_AGENT_DATA_ROOT=.graphmine-agent
GRAPHMINE_BINARY=library/build/graphmine
GRAPHMINE_MAX_UPLOAD_BYTES=2147483648
GRAPHMINE_JOB_TIMEOUT_SECONDS=86400
GRAPHMINE_RESULT_SUMMARY_ITEMS=50
