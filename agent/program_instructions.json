        "result_limit": {
          "flag": "--result-limit",
          "type": "integer",
          "minimum": 1
        }
      },
      "optional_outputs": {
        "total_count": "--include-total-count"
      },
      "auxiliary_inputs": {},
      "required_outputs": [
        "cliques",
        "returned_count",
        "complete"
      ],
      "visualization_candidates": [
        "network",
        "table",
        "metric_cards"
      ]
    },
    {
