    {
      "id": "eval-infrastructure-community",
      "split": "held_out_evaluation",
      "domain_id": "communications_infrastructure",
      "user_query": "Detect modularity communities in the unweighted undirected router topology.",
      "expected": {"problem_id": "community_detection", "operation_id": "community-detection", "supported": true}
    },
    {
      "id": "eval-transport-centrality",
      "split": "held_out_evaluation",
      "domain_id": "transportation_mobility",
