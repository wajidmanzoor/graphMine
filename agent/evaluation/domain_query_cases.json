      "expected": {"problem_id": "k_clique_counting_enumeration", "operation_id": "k-cliques", "supported": true, "parameters": {"k": 5}}
    },
    {
      "id": "eval-social-quasi-cliques",
      "split": "held_out_evaluation",
      "domain_id": "social_networks",
      "user_query": "Find dense but not necessarily complete collaboration circles with at least 6 members and density threshold 0.75.",
      "expected": {"problem_id": "quasi_clique_mining", "operation_id": "quasi-cliques", "supported": true, "parameters": {"minimum_size": 6, "minimum_degree_ratio": 0.75}}
    },
    {
      "id": "eval-bio-k-core",
      "split": "held_out_evaluation",
      "domain_id": "bioinformatics",
      "user_query": "Calculate each protein's core number and the degeneracy of the interaction network.",
      "expected": {"problem_id": "k_core_decomposition", "operation_id": "k-core", "supported": true}
    },
    {
      "id": "eval-ecommerce-bicliques",
      "split": "held_out_evaluation",
      "domain_id": "recommendation_ecommerce",
      "user_query": "Find maximal groups where every selected customer bought every selected product; the customer partition is attached.",
      "expected": {"problem_id": "maximal_biclique_enumeration", "operation_id": "maximal-bicliques", "supported": true, "auxiliary_roles": ["left_partition"]}
    },
    {
      "id": "eval-social-triangles",
      "split": "held_out_evaluation",
      "domain_id": "social_networks",
      "user_query": "Measure triadic closure by counting all friendship triangles.",
      "expected": {"problem_id": "triangle_counting_listing", "operation_id": "triangle-counting", "supported": true}
    },
    {
      "id": "eval-general-dynamic-triangles",
      "split": "held_out_evaluation",
      "domain_id": "general",
      "user_query": "After applying my insertion and deletion file, compute the net change in triangle count.",
      "expected": {"problem_id": "triangle_counting_listing", "operation_id": "dynamic-triangle-counting", "supported": true, "auxiliary_roles": ["updates"]}
    },
    {
      "id": "eval-cyber-motifs",
      "split": "held_out_evaluation",
      "domain_id": "cybersecurity",
      "user_query": "Count the attached non-induced communication motifs across the host graph.",
      "expected": {"problem_id": "graph_motif_counting", "operation_id": "graph-motifs", "supported": true, "parameters": {"induced": false}, "auxiliary_roles": ["motif"]}
    },
    {
      "id": "eval-knowledge-subgraph",
      "split": "held_out_evaluation",
      "domain_id": "knowledge_graphs",
      "user_query": "Find every embedding of the attached query pattern in the entity graph while respecting labels.",
      "expected": {"problem_id": "subgraph_isomorphism", "operation_id": "subgraph-isomorphism", "supported": true, "optional_outputs": ["embeddings"], "auxiliary_roles": ["query_graph"]}
    },
    {
      "id": "eval-fraud-temporal",
      "split": "held_out_evaluation",
      "domain_id": "fraud_detection",
      "user_query": "Count time-ordered A-to-B, B-to-C, A-to-C transfer patterns completed within 3600 seconds.",
      "expected": {"problem_id": "temporal_motif_mining", "operation_id": "temporal-motif-mining", "supported": true, "parameters": {"max_time_span": 3600}}
