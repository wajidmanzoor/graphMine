GCC=g++
GCCFLAG=-O3 -fopenmp
INDEXTYPE64=-DOFFSET_64
INDEXTYPE32=-DOFFSET_32
all: SNAP2CSR64 SNAP2CSR32 CSR2ADJ32 CSR2ADJ64
SNAP2CSR64: SNAP2CSR.cpp
	$(GCC) $(GCCFLAG) SNAP2CSR.cpp -o SNAP2CSR64 $(INDEXTYPE64)
SNAP2CSR32: SNAP2CSR.cpp
	$(GCC) $(GCCFLAG) SNAP2CSR.cpp -o SNAP2CSR32 $(INDEXTYPE32)
CSR2ADJ32: CSR2ADJ.cpp
	$(GCC) $(GCCFLAG) CSR2ADJ.cpp -o CSR2ADJ32 $(INDEXTYPE32)
CSR2ADJ64: CSR2ADJ.cpp
	$(GCC) $(GCCFLAG) CSR2ADJ.cpp -o CSR2ADJ64 $(INDEXTYPE64)
.PHONY: clean
clean :
	rm SNAP2CSR64 SNAP2CSR32 CSR2ADJ32 CSR2ADJ64