{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hypergraph_input.schema.json",
  "title": "Canonical Hypergraph Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph",
    "vertices",
    "hyperedges"
  ],
  "properties": {
    "graph": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "vertices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "graph_input.schema.json#/$defs/external_id"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    },
    "hyperedges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "vertices"
        ],
        "properties": {
          "id": {
            "$ref": "graph_input.schema.json#/$defs/external_id"
          },
          "vertices": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "graph_input.schema.json#/$defs/external_id"
            }
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    }
  }
}
