@INCLUDE = tools/code_docs/Doxyfile.common

PROJECT_NAME           = "GraphMine library code reference"
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "Function-level C++ and CUDA documentation"
PROJECT_LOGO           = tools/code_docs/graphmine-mark.svg
OUTPUT_DIRECTORY       = docs/reference/library
CREATE_SUBDIRS         = YES
ALLOW_UNICODE_NAMES    = YES
FULL_SIDEBAR           = YES
HTML_OUTPUT            = .
INPUT                  = tools/code_docs/library-main.dox \
                         library/include \
                         library/src \
                         library/examples \
                         library/tests
EXAMPLE_PATH           = library/examples
EXCLUDE_PATTERNS      += */tests/install_consumer/build/*
